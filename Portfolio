<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hamwi Productions | Sports & Athletic Photography</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;800&display=swap');
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
  </style>
</head>
<body class="bg-neutral-950 text-neutral-100 antialiased selection:bg-red-600 selection:text-white">

  <!-- Navigation -->
  <nav class="fixed top-0 left-0 w-full z-50 bg-neutral-950/80 backdrop-blur-md border-b border-neutral-800/50">
    <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
      <a href="#" class="text-xl font-extrabold tracking-wider uppercase text-white">
        Hamwi<span class="text-red-500">.</span>
      </a>
      <div class="hidden md:flex space-x-8 text-sm uppercase tracking-widest font-semibold text-neutral-400">
        <a href="#work" class="hover:text-white transition-colors">Work</a>
        <a href="#about" class="hover:text-white transition-colors">About</a>
        <a href="#services" class="hover:text-white transition-colors">Services</a>
        <a href="#contact" class="hover:text-white transition-colors">Contact</a>
      </div>
      <a href="#contact" class="hidden sm:inline-flex items-center px-5 py-2.5 bg-red-600 hover:bg-red-700 text-white text-xs font-bold uppercase tracking-widest transition-all rounded-sm">
        Book Session
      </a>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="relative min-h-screen flex items-center justify-center pt-20 px-6 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-neutral-800/40 via-neutral-950 to-neutral-950 -z-10"></div>
    <div class="max-w-4xl mx-auto text-center space-y-6">
      <span class="inline-block text-red-500 text-xs font-bold uppercase tracking-[0.3em] bg-red-500/10 px-4 py-1.5 rounded-full border border-red-500/20">
        Sports & Performance Media
      </span>
      <h1 class="text-5xl sm:text-7xl font-extrabold uppercase tracking-tight text-white leading-tight">
        Hamwi Productions
      </h1>
      <p class="text-lg sm:text-xl text-neutral-400 max-w-2xl mx-auto font-light leading-relaxed">
        Capturing high-impact athletic performance, game-day intensity, and visual stories across all visual disciplines.
      </p>
      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="#work" class="w-full sm:w-auto px-8 py-3.5 bg-white text-neutral-900 font-bold uppercase tracking-wider text-xs hover:bg-neutral-200 transition-colors">
          Explore Portfolio
        </a>
        <a href="#contact" class="w-full sm:w-auto px-8 py-3.5 border border-neutral-700 font-bold uppercase tracking-wider text-xs hover:border-white transition-colors">
          Get In Touch
        </a>
      </div>
    </div>
  </section>

  <!-- Gallery Section -->
  <section id="work" class="py-24 px-6 max-w-7xl mx-auto border-t border-neutral-900">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
      <div>
        <h2 class="text-3xl font-extrabold uppercase tracking-tight">Selected Work</h2>
        <p class="text-neutral-500 mt-2 text-sm">Featured shots from the <a href="https://lightroom.adobe.com/shares/51b7168d7f0441ea8df50a30acd0d7bf" target="_blank" rel="noopener noreferrer" class="text-red-500 hover:underline">August 27, 2026 Collection</a> by Usef Hamwi.</p>
      </div>
    </div>

    <!-- Gallery Grid (Add your direct image file paths/URLs to the src attributes) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      
      <!-- Photo 1: B&W Wrestling Portrait -->
      <div class="group relative aspect-[4/5] bg-neutral-900 overflow-hidden rounded-sm">
        <img src="path-to-your-wrestling-photo.jpg" alt="Eagles Wrestling B&W Portrait" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
        <div class="absolute inset-0 bg-gradient-to-t from-neutral-950/80 via-transparent opacity-0 group-hover:opacity-100 transition-opacity p-6 flex flex-col justify-end">
          <p class="text-xs text-red-500 font-bold tracking-widest uppercase">Wrestling</p>
          <p class="text-sm font-semibold text-white">Eagles Athletics B&W Portrait</p>
        </div>
      </div>

      <!-- Photo 2: Sunset Soccer Silhouette -->
      <div class="group relative aspect-[4/5] bg-neutral-900 overflow-hidden rounded-sm">
        <img src="path-to-your-sunset-soccer-photo.jpg" alt="Player #7 Sunset Silhouette" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
        <div class="absolute inset-0 bg-gradient-to-t from-neutral-950/80 via-transparent opacity-0 group-hover:opacity-100 transition-opacity p-6 flex flex-col justify-end">
          <p class="text-xs text-red-500 font-bold tracking-widest uppercase">Soccer</p>
          <p class="text-sm font-semibold text-white">Golden Hour Profile (#7)</p>
        </div>
      </div>

      <!-- Photo 3: Baseball Celebration -->
      <div class="group relative aspect-[4/5] bg-neutral-900 overflow-hidden rounded-sm">
        <img src="path-to-your-baseball-photo.jpg" alt="Baseball Team Celebration Under Sunset" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
        <div class="absolute inset-0 bg-gradient-to-t from-neutral-950/80 via-transparent opacity-0 group-hover:opacity-100 transition-opacity p-6 flex flex-col justify-end">
          <p class="text-xs text-red-500 font-bold tracking-widest uppercase">Baseball</p>
          <p class="text-sm font-semibold text-white">Post-Game Celebration</p>
        </div>
      </div>

      <!-- Photo 4: Player Backlight (#5) -->
      <div class="group relative aspect-[4/5] bg-neutral-900 overflow-hidden rounded-sm">
        <img src="path-to-your-player-backlight-photo.jpg" alt="Player #5 Sun Flare Portrait" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
        <div class="absolute inset-0 bg-gradient-to-t from-neutral-950/80 via-transparent opacity-0 group-hover:opacity-100 transition-opacity p-6 flex flex-col justify-end">
          <p class="text-xs text-red-500 font-bold tracking-widest uppercase">Portrait</p>
          <p class="text-sm font-semibold text-white">High-Contrast Athlete Silhouette (#5)</p>
        </div>
      </div>

      <!-- Photo 5: Football Tackle Action -->
      <div class="group relative aspect-[4/5] bg-neutral-900 overflow-hidden rounded-sm">
        <img src="path-to-your-football-photo.jpg" alt="High School Football Tackle Shot" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
        <div class="absolute inset-0 bg-gradient-to-t from-neutral-950/80 via-transparent opacity-0 group-hover:opacity-100 transition-opacity p-6 flex flex-col justify-end">
          <p class="text-xs text-red-500 font-bold tracking-widest uppercase">Football</p>
          <p class="text-sm font-semibold text-white">Game Day Tackle Action</p>
        </div>
      </div>

      <!-- Photo 6: Field Soccer Action -->
      <div class="group relative aspect-[4/5] bg-neutral-900 overflow-hidden rounded-sm">
        <img src="path-to-your-soccer-action-photo.jpg" alt="Soccer Action Duel" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
        <div class="absolute inset-0 bg-gradient-to-t from-neutral-950/80 via-transparent opacity-0 group-hover:opacity-100 transition-opacity p-6 flex flex-col justify-end">
          <p class="text-xs text-red-500 font-bold tracking-widest uppercase">Soccer</p>
          <p class="text-sm font-semibold text-white">Mid-Match Battle</p>
        </div>
      </div>

    </div>
  </section>

  <!-- About Section -->
  <section id="about" class="py-24 px-6 bg-neutral-900/50 border-t border-b border-neutral-900">
    <div class="max-w-4xl mx-auto text-center space-y-6">
      <h2 class="text-xs font-bold uppercase tracking-[0.3em] text-red-500">About Usef Hamwi</h2>
      <h3 class="text-3xl sm:text-4xl font-extrabold uppercase text-white">Behind Hamwi Productions</h3>
      <p class="text-neutral-400 text-lg leading-relaxed max-w-2xl mx-auto font-light">
        Founded by Usef Hamwi, Hamwi Productions specializes in capturing peak athletic performance and high-energy sports media. With a focus on precision timing, lighting, and narrative drive, we document athletes and team events with professional consistency. While athletics is our core passion, we bring the same technical sharpness and creative eye to projects across all industries.
      </p>
    </div>
  </section>

  <!-- Services Section -->
  <section id="services" class="py-24 px-6 max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <h2 class="text-3xl font-extrabold uppercase tracking-tight">Services & Pricing</h2>
      <p class="text-neutral-500 mt-2 text-sm">Custom visual packages tailored to your project requirements.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="bg-neutral-900/40 p-8 border border-neutral-800 rounded-sm hover:border-neutral-700 transition-colors">
        <i data-lucide="camera" class="w-8 h-8 text-red-500 mb-6"></i>
        <h3 class="text-xl font-bold uppercase mb-3">Game Day Coverage</h3>
        <p class="text-neutral-400 text-sm leading-relaxed mb-6">Full-game or match coverage delivering high-resolution action imagery and key game moments.</p>
        <span class="inline-block text-xs uppercase font-bold tracking-widest text-neutral-300 bg-neutral-800 px-3 py-1">Contact for Pricing</span>
      </div>

      <div class="bg-neutral-900/40 p-8 border border-neutral-800 rounded-sm hover:border-neutral-700 transition-colors">
        <i data-lucide="user" class="w-8 h-8 text-red-500 mb-6"></i>
        <h3 class="text-xl font-bold uppercase mb-3">Athlete Portraits</h3>
        <p class="text-neutral-400 text-sm leading-relaxed mb-6">Stylized portraiture and media day sessions designed for individual athletes and sports brands.</p>
        <span class="inline-block text-xs uppercase font-bold tracking-widest text-neutral-300 bg-neutral-800 px-3 py-1">Contact for Pricing</span>
      </div>

      <div class="bg-neutral-900/40 p-8 border border-neutral-800 rounded-sm hover:border-neutral-700 transition-colors">
        <i data-lucide="layers" class="w-8 h-8 text-red-500 mb-6"></i>
        <h3 class="text-xl font-bold uppercase mb-3">Commercial & Events</h3>
        <p class="text-neutral-400 text-sm leading-relaxed mb-6">Tailored visual production for brands, tournaments, corporate events, and non-athletic media needs.</p>
        <span class="inline-block text-xs uppercase font-bold tracking-widest text-neutral-300 bg-neutral-800 px-3 py-1">Contact for Pricing</span>
      </div>
    </div>
  </section>

  <!-- Contact & Booking Form -->
  <section id="contact" class="py-24 px-6 bg-neutral-900/30 border-t border-neutral-900">
    <div class="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12">
      <div class="space-y-6">
        <h2 class="text-3xl font-extrabold uppercase tracking-tight">Book a Session</h2>
        <p class="text-neutral-400 text-sm leading-relaxed">
          Submit your booking request below. Form inquiries send automated notification emails straight to <span class="text-white font-medium">Hamwi.productions@gmail.com</span> for review and confirmation.
        </p>

        <div class="space-y-4 pt-4">
          <div class="flex items-center space-x-3 text-neutral-300 text-sm">
            <i data-lucide="mail" class="w-5 h-5 text-red-500"></i>
            <span>Hamwi.productions@gmail.com</span>
          </div>
          <div class="flex items-center space-x-3 text-neutral-300 text-sm">
            <i data-lucide="phone" class="w-5 h-5 text-red-500"></i>
            <span>(315) 518-2035</span>
          </div>
          <div class="flex items-center space-x-3 text-neutral-300 text-sm">
            <i data-lucide="instagram" class="w-5 h-5 text-red-500"></i>
            <a href="https://www.instagram.com" target="_blank" rel="noopener noreferrer" class="hover:underline">Follow on Instagram</a>
          </div>
        </div>
      </div>

      <!-- Formspree Notification Form -->
      <form action="https://formspree.io/f/xvON-YOUR-FORM-ID-HERE" method="POST" class="space-y-4">
        <div>
          <label class="block text-xs font-bold uppercase tracking-widest text-neutral-400 mb-2">Name</label>
          <input type="text" name="name" required class="w-full bg-neutral-950 border border-neutral-800 rounded-sm px-4 py-3 text-sm focus:outline-none focus:border-red-600 transition-colors">
        </div>
        <div>
          <label class="block text-xs font-bold uppercase tracking-widest text-neutral-400 mb-2">Email</label>
          <input type="email" name="email" required class="w-full bg-neutral-950 border border-neutral-800 rounded-sm px-4 py-3 text-sm focus:outline-none focus:border-red-600 transition-colors">
        </div>
        <div>
          <label class="block text-xs font-bold uppercase tracking-widest text-neutral-400 mb-2">Event Date & Details</label>
          <textarea name="message" rows="4" required placeholder="Tell us about the sport/event, location, and requested date..." class="w-full bg-neutral-950 border border-neutral-800 rounded-sm px-4 py-3 text-sm focus:outline-none focus:border-red-600 transition-colors"></textarea>
        </div>
        <button type="submit" class="w-full py-3.5 bg-red-600 hover:bg-red-700 text-white font-bold uppercase tracking-wider text-xs transition-colors rounded-sm">
          Send Booking Request
        </button>
      </form>
    </div>
  </section>

  <!-- Footer -->
  <footer class="py-8 px-6 border-t border-neutral-900 text-center text-neutral-600 text-xs uppercase tracking-widest">
    © 2026 Hamwi Productions. All rights reserved.
  </footer>

  <script>
    lucide.createIcons();
  </script>
</body>
</html>